#!/usr/bin/env bash
# Prepare local release artifacts only. Uploading/publishing is deliberately separate.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"
export NUCLEUS_PUBLISH_MODE=never
./gradlew test packageDmg packageZip "$@"
if [[ " ${*:-} " == *" -PsignedRelease=true "* ]]; then
  TOOLS="${SPARKLE_TOOLS_DIR:-$ROOT_DIR/.derivedData/SourcePackages/artifacts/sparkle/Sparkle/bin}"
  [[ -x "$TOOLS/generate_appcast" ]] || { echo 'Set SPARKLE_TOOLS_DIR to Sparkle signing tools.' >&2; exit 1; }
  STAGING="$ROOT_DIR/build/sparkle"
  mkdir -p "$STAGING"
  find "$STAGING" -maxdepth 1 -type f -delete
  find "$ROOT_DIR/build/compose/binaries/main/dmg" -name '*.dmg' -exec cp {} "$STAGING/AvdBuddy.dmg" \;
  "$TOOLS/generate_appcast" --account avdbuddy --maximum-versions 1 \
    --download-url-prefix https://github.com/alexstyl/avdbuddy/releases/latest/download/ \
    --link https://github.com/alexstyl/avdbuddy -o "$STAGING/appcast.xml" "$STAGING"
fi
printf 'Local artifacts: %s\nNothing was published.\n' "$ROOT_DIR/build/compose/binaries/main"
