#!/usr/bin/env bash
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${ROOT_DIR}"
./gradlew createDistributable
APP_PATH="${ROOT_DIR}/build/compose/binaries/main/app/AvdBuddy.app"
pkill -f "${APP_PATH}/Contents/MacOS/AvdBuddy" >/dev/null 2>&1 || true
open -n "${APP_PATH}" --args "$@"
